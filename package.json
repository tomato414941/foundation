{
  "name": "foundation",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "test": "node --test test/*.test.mjs src/adapters/*/*.test.mjs src/schemes/*.test.mjs",
    "check": "for source in src/*.mjs src/adapters/*.mjs src/adapters/*/*.mjs src/schemes/*.mjs src/runners/*.mjs cli/*.mjs web/*.js; do node --check \"$source\" || exit; done"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "ajv": "8.20.0",
    "swagger-ui-dist": "5.33.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0"
  }
}
