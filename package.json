{
  "name": "foundation",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server/main.ts",
    "dev:web": "react-router dev",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "build": "npm run build:server && npm run build:web && npm run build:cli",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-assets.mjs",
    "build:web": "react-router build",
    "build:cli": "esbuild cli/src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=cli/dist/cli.mjs",
    "check": "react-router typegen && tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test --test-timeout=60000 tests/*.test.ts",
    "test:ui": "python3 tests/browser.py"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1146.0",
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/client-sts": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@fastify/swagger": "9.9.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/type-provider-zod": "1.0.0",
    "@fedify/uri-template": "2.3.10",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "safe-regex2": "5.1.1",
    "stripe": "23.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@react-router/dev": "8.4.0",
    "@react-router/node": "8.4.0",
    "@simplewebauthn/browser": "14.0.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "i18next": "26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-router": "8.4.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
