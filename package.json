{
  "name": "foundation",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:web": "react-router dev",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "build": "npm run build:server && npm run build:web && npm run build:cli",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-assets.mjs",
    "build:web": "react-router build",
    "build:cli": "node scripts/build-cli.mjs",
    "check": "react-router typegen && tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "npm run build:cli && node --import tsx --test --test-timeout=60000 tests/*.test.ts",
    "test:ui": "python3 tests/browser.py",
    "dev:server": "tsx watch --env-file-if-exists=.env server/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1146.0",
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/client-sts": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@fastify/swagger": "9.9.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/type-provider-zod": "1.0.0",
    "@fedify/uri-template": "2.3.10",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "oauth4webapi": "3.8.8",
    "pg": "8.23.1",
    "safe-regex2": "5.1.1",
    "standardwebhooks": "1.1.1",
    "stripe": "23.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@react-router/dev": "8.4.0",
    "@react-router/node": "8.4.0",
    "@simplewebauthn/browser": "14.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "esbuild": "0.28.2",
    "get-nonce": "1.0.1",
    "i18next": "26.4.2",
    "lucide-react": "1.52.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-router": "8.4.0",
    "shadcn": "4.21.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
