{
  "id": "gitlab",
  "name": "GitLab",
  "api": "https://gitlab.com/api/v4",
  "docs": "https://docs.gitlab.com/api/rest/",
  "console": "https://gitlab.com/-/user_settings/applications",
  "methods": {
    "oauth": {
      "name": "GitLab · Connect in browser",
      "kind": "oauth",
      "config": {
        "authorizeUrl": "https://gitlab.com/oauth/authorize",
        "tokenUrl": "https://gitlab.com/oauth/token",
        "clientAuth": "body",
        "pkce": true,
        "tokenFormat": "form",
        "authorizeParams": {},
        "tokenParams": {},
        "defaults": {},
        "fields": [],
        "outputs": {
          "GITLAB_ACCESS_TOKEN": "/accessToken",
          "GITLAB_TOKEN_EXPIRES_AT": "/expiresAt"
        },
        "identity": {
          "url": "https://gitlab.com/api/v4/user",
          "id": "/id",
          "name": [
            "/username",
            "/email"
          ]
        },
        "revoke": {
          "url": "https://gitlab.com/oauth/revoke",
          "style": "rfc7009"
        },
        "scopes": {
          "default": [
            "read_user"
          ],
          "separator": " ",
          "docs": "https://docs.gitlab.com/integration/oauth_provider/#view-all-authorized-applications"
        }
      },
      "docs": "https://docs.gitlab.com/api/rest/",
      "console": "https://gitlab.com/-/user_settings/applications"
    },
    "token": {
      "name": "GitLab · Enter access token",
      "kind": "token",
      "config": {
        "fields": [
          {
            "name": "token",
            "label": "Personal access token",
            "secret": true
          }
        ],
        "console": "https://gitlab.com/-/user_settings/personal_access_tokens",
        "outputs": {
          "GITLAB_TOKEN": "/token"
        }
      },
      "docs": "https://docs.gitlab.com/api/rest/",
      "console": "https://gitlab.com/-/user_settings/applications"
    }
  }
}
