{
  "id": "calendly",
  "name": "Calendly",
  "api": "https://api.calendly.com",
  "docs": "https://developer.calendly.com/api-docs",
  "console": "https://developer.calendly.com/",
  "auth": {
    "oauth": {
      "authorizeUrl": "https://auth.calendly.com/oauth/authorize",
      "tokenUrl": "https://auth.calendly.com/oauth/token",
      "clientAuth": "body",
      "pkce": true,
      "tokenFormat": "form",
      "authorizeParams": {},
      "tokenParams": {},
      "defaults": {},
      "fields": [],
      "outputs": {
        "CALENDLY_ACCESS_TOKEN": "/accessToken",
        "CALENDLY_TOKEN_EXPIRES_AT": "/expiresAt"
      },
      "identity": {
        "url": "https://api.calendly.com/users/me",
        "id": "/resource/uri",
        "name": [
          "/resource/email",
          "/resource/name"
        ]
      },
      "revoke": {
        "url": "https://auth.calendly.com/oauth/revoke",
        "style": "rfc7009"
      },
      "scopes": {
        "default": [],
        "separator": " "
      }
    },
    "token": {
      "fields": [
        {
          "name": "token",
          "label": "Personal access token",
          "secret": true
        }
      ],
      "console": "https://calendly.com/integrations/api_webhooks",
      "outputs": {
        "CALENDLY_TOKEN": "/token"
      }
    }
  }
}
