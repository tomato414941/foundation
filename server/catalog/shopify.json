{
  "id": "shopify",
  "name": "Shopify",
  "docs": "https://shopify.dev/docs/api/admin-graphql",
  "console": "https://partners.shopify.com/",
  "methods": {
    "oauth": {
      "name": "Shopify · Connect in browser",
      "kind": "oauth",
      "config": {
        "authorizeUrl": "https://{shop}.myshopify.com/admin/oauth/authorize",
        "tokenUrl": "https://{shop}.myshopify.com/admin/oauth/access_token",
        "clientAuth": "body",
        "pkce": false,
        "tokenFormat": "form",
        "authorizeParams": {},
        "tokenParams": {},
        "defaults": {},
        "fields": [
          {
            "name": "shop",
            "label": "ストア名",
            "required": true,
            "placeholder": "example（example.myshopify.com の場合）",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          }
        ],
        "outputs": {
          "SHOPIFY_ACCESS_TOKEN": "/accessToken",
          "SHOPIFY_SHOP": "/shop",
          "SHOPIFY_TOKEN_EXPIRES_AT": "/expiresAt"
        },
        "identity": {
          "from": "app",
          "id": "/shop",
          "name": "/name"
        },
        "hint": "The access token is sent in the \"X-Shopify-Access-Token\" header to https://<SHOPIFY_SHOP>.myshopify.com/admin/api/<version>/graphql.json. SHOPIFY_SHOP is the store name (<SHOPIFY_SHOP>.myshopify.com).",
        "scopes": {
          "default": [],
          "separator": ",",
          "docs": "https://shopify.dev/docs/api/usage/access-scopes"
        }
      },
      "docs": "https://shopify.dev/docs/api/admin-graphql",
      "console": "https://partners.shopify.com/"
    },
    "client_credentials": {
      "name": "Shopify · Connect with app credentials",
      "kind": "oauth",
      "config": {
        "grantType": "client_credentials",
        "authorizeUrl": "https://{shop}.myshopify.com/admin/oauth/authorize",
        "tokenUrl": "https://{shop}.myshopify.com/admin/oauth/access_token",
        "clientAuth": "body",
        "pkce": false,
        "fields": [
          {
            "name": "shop",
            "label": "Store name",
            "required": true,
            "placeholder": "example",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          }
        ],
        "identity": {
          "url": "https://{shop}.myshopify.com/admin/api/2026-07/graphql.json",
          "method": "POST",
          "id": "/data/shop/id",
          "name": "/data/shop/name"
        },
        "scopes": {
          "default": [],
          "separator": ",",
          "docs": "https://shopify.dev/docs/api/usage/access-scopes"
        },
        "outputs": {
          "SHOPIFY_ACCESS_TOKEN": "/accessToken",
          "SHOPIFY_SHOP": "/shop",
          "SHOPIFY_TOKEN_EXPIRES_AT": "/expiresAt"
        },
        "hint": "Use an app installed on a store in your own Shopify organization. Set access scopes in the Dev Dashboard."
      },
      "docs": "https://shopify.dev/docs/apps/build/authentication-authorization/client-credentials-grant",
      "console": "https://dev.shopify.com/dashboard"
    },
    "token": {
      "name": "Shopify · Enter access token",
      "kind": "token",
      "config": {
        "fields": [
          {
            "name": "shop",
            "label": "ストア名",
            "placeholder": "example（example.myshopify.com の場合）",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          {
            "name": "token",
            "label": "Admin APIのアクセストークン",
            "secret": true
          }
        ],
        "hint": "Send the token in the \"X-Shopify-Access-Token\" header to https://<SHOPIFY_SHOP>.myshopify.com/admin/api/<version>/graphql.json.",
        "outputs": {
          "SHOPIFY_SHOP": "/shop",
          "SHOPIFY_ACCESS_TOKEN": "/token"
        }
      },
      "docs": "https://shopify.dev/docs/api/admin-graphql",
      "console": "https://partners.shopify.com/"
    }
  }
}
