{
  "id": "ovh",
  "name": "OVHcloud",
  "docs": "https://docs.ovhcloud.com/en/guides/manage-and-operate/api/manage-service-account",
  "methods": {
    "client_credentials": {
      "name": "OVHcloud · Connect with app credentials",
      "kind": "oauth",
      "config": {
        "grantType": "client_credentials",
        "tokenUrl": "{+tokenUrl}",
        "clientAuth": "body",
        "pkce": false,
        "identity": {
          "from": "app",
          "id": "/clientId",
          "name": "/clientId"
        },
        "defaults": {},
        "scopes": {
          "default": [
            "all"
          ],
          "docs": "https://docs.ovhcloud.com/en/guides/account-and-service-management/account-information/authenticate-api-with-service-account"
        },
        "outputs": {
          "OVH_ACCESS_TOKEN": "/accessToken",
          "OVH_CLIENT_ID": "/clientId",
          "OVH_API_BASE_URL": "/apiBaseUrl",
          "OVH_ENDPOINT": "/endpoint",
          "OVH_TOKEN_EXPIRES_AT": "/expiresAt",
          "OVH_API_REGION": "/apiRegion"
        },
        "hint": "Use a service account for the selected account API region. OVH_ACCESS_TOKEN authenticates requests to OVH_API_BASE_URL. The OAuth scope all does not describe IAM permissions; allowed operations and resources are configured in OVHcloud IAM policies. The client ID identifies the configured service account; the account owner and IAM permissions have not been verified.",
        "fields": [
          {
            "name": "apiRegion",
            "label": "Account API region",
            "required": true,
            "choices": [
              {
                "value": "eu",
                "label": "EU",
                "values": {
                  "tokenUrl": "https://www.ovh.com/auth/oauth2/token",
                  "apiBaseUrl": "https://eu.api.ovh.com/1.0",
                  "endpoint": "ovh-eu",
                  "consoleHost": "www.ovh.com"
                }
              },
              {
                "value": "ca",
                "label": "CA",
                "values": {
                  "tokenUrl": "https://ca.ovh.com/auth/oauth2/token",
                  "apiBaseUrl": "https://ca.api.ovh.com/1.0",
                  "endpoint": "ovh-ca",
                  "consoleHost": "ca.ovh.com"
                }
              },
              {
                "value": "us",
                "label": "US",
                "values": {
                  "tokenUrl": "https://us.ovhcloud.com/auth/oauth2/token",
                  "apiBaseUrl": "https://api.us.ovhcloud.com/1.0",
                  "endpoint": "ovh-us",
                  "consoleHost": "us.ovhcloud.com"
                }
              }
            ],
            "secret": false
          }
        ]
      },
      "docs": "https://docs.ovhcloud.com/en/guides/manage-and-operate/api/manage-service-account",
      "console": "https://{consoleHost}/manager/"
    }
  }
}
