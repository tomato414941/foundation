{
  "id": "cloudflare",
  "name": "Cloudflare",
  "api": "https://api.cloudflare.com/client/v4",
  "docs": "https://developers.cloudflare.com/api/",
  "methods": {
    "oauth": {
      "name": "Cloudflare · Connect in browser",
      "kind": "oauth",
      "config": {
        "authorizeUrl": "https://dash.cloudflare.com/oauth2/auth",
        "tokenUrl": "https://dash.cloudflare.com/oauth2/token",
        "scopes": {
          "default": [
            "offline_access",
            "user-details.read"
          ],
          "docs": "https://developers.cloudflare.com/fundamentals/oauth/"
        },
        "outputs": {
          "CLOUDFLARE_API_TOKEN": "/accessToken",
          "CLOUDFLARE_OAUTH_EXPIRES_AT": "/expiresAt"
        },
        "hint": "Use CLOUDFLARE_API_TOKEN as a Bearer token with Cloudflare v4 APIs. Scopes are the dot-delimited Cloudflare IDs, such as dns.write or email-routing-rule.write. List /accounts when using the token and choose the target explicitly. Domain registrations and renewals incur charges."
      },
      "docs": "https://developers.cloudflare.com/api/"
    },
    "token": {
      "name": "Cloudflare · Enter API token",
      "kind": "token",
      "config": {
        "fields": [
          {
            "name": "token",
            "label": "APIトークン",
            "secret": true
          }
        ],
        "console": "https://dash.cloudflare.com/profile/api-tokens",
        "outputs": {
          "CLOUDFLARE_API_TOKEN": "/token"
        }
      },
      "docs": "https://developers.cloudflare.com/api/"
    }
  }
}
