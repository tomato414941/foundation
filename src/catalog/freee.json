        "label": [
          "/user/email",
          "/user/display_name"
        ]
      },
      "revoke": {
        "url": "https://accounts.secure.freee.co.jp/public_api/revoke",
        "style": "rfc7009"
      },
      "scopes": {
        "base": [],
        "docs": "https://developer.freee.co.jp/startguide/basic/oauth"
      },
      "injection": {
        "FREEE_ACCESS_TOKEN": "/access_token",
        "FREEE_TOKEN_EXPIRES_AT": "/expires_at"
      }
    }
  }
