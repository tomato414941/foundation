{
  "id": "calendly",
  "name": "Calendly",
  "api": "https://api.calendly.com",
  "docs": "https://developer.calendly.com/api-docs",
  "console": "https://developer.calendly.com/",
  "auth_schemes": {
    "oauth": {
      "authorize": "https://auth.calendly.com/oauth/authorize",
      "token": "https://auth.calendly.com/oauth/token",
      "client_auth": "body",
      "identity": {
        "url": "https://api.calendly.com/users/me",
        "id": "/resource/uri",
        "label": [
          "/resource/email",
          "/resource/name"
        ]
      },
      "revoke": {
        "url": "https://auth.calendly.com/oauth/revoke",
        "style": "rfc7009"
      },
      "injection": {
        "CALENDLY_ACCESS_TOKEN": "/access_token",
        "CALENDLY_TOKEN_EXPIRES_AT": "/expires_at"
      }
    },
    "token": {
      "fields": [
        {
          "name": "token",
          "label": "Personal access token",
          "secret": true
        }
      ],
      "console": "https://calendly.com/integrations/api_webhooks",
      "injection": {
        "CALENDLY_TOKEN": "/token"
      }
    }
  }
}
