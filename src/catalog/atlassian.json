{
  "id": "atlassian",
  "name": "Atlassian",
  "api": "https://api.atlassian.com",
  "docs": "https://developer.atlassian.com/cloud/",
  "console": "https://developer.atlassian.com/console/myapps/",
  "auth_schemes": {
    "oauth": {
      "authorize": "https://auth.atlassian.com/authorize",
      "token": "https://auth.atlassian.com/oauth/token",
      "authorize_params": {
        "audience": "api.atlassian.com",
        "prompt": "consent"
      },
      "client_auth": "body",
      "token_format": "json",
      "identity": {
        "url": "https://api.atlassian.com/me",
        "id": "/account_id",
        "label": [
          "/email",
          "/name"
        ]
      },
      "scopes": {
        "base": [
          "offline_access",
          "read:me"
        ],
        "docs": "https://developer.atlassian.com/cloud/jira/platform/scopes-for-oauth-2-3LO-and-forge-apps/"
      },
      "injection": {
        "ATLASSIAN_ACCESS_TOKEN": "/access_token",
        "ATLASSIAN_TOKEN_EXPIRES_AT": "/expires_at"
      },
      "hint": "Find the site (cloud ID) with GET https://api.atlassian.com/oauth/token/accessible-resources, then call https://api.atlassian.com/ex/jira/<cloudid>/... or /ex/confluence/<cloudid>/..."
    },
    "token": {
      "fields": [
        {
          "name": "site",
          "label": "サイト",
          "placeholder": "example.atlassian.net",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}\\.atlassian\\.net$"
        },
        {
          "name": "email",
          "label": "Atlassianアカウントのメールアドレス"
        },
        {
          "name": "token",
          "label": "APIトークン",
          "secret": true
        }
      ],
      "console": "https://id.atlassian.com/manage-profile/security/api-tokens",
      "injection": {
        "ATLASSIAN_SITE": "/site",
        "ATLASSIAN_EMAIL": "/email",
        "ATLASSIAN_API_TOKEN": "/token"
      },
      "hint": "Use HTTP Basic auth with ATLASSIAN_EMAIL as the user and ATLASSIAN_API_TOKEN as the password against https://<ATLASSIAN_SITE>/rest/api/3/... (Jira) or /wiki/rest/api/... (Confluence)."
    }
  }
}
