{
  "id": "box",
  "name": "Box",
  "api": "https://api.box.com/2.0",
  "docs": "https://developer.box.com/reference/",
  "console": "https://app.box.com/developers/console",
  "auth_schemes": {
    "oauth": {
      "authorize": "https://account.box.com/api/oauth2/authorize",
      "token": "https://api.box.com/oauth2/token",
      "client_auth": "body",
      "identity": {
        "url": "https://api.box.com/2.0/users/me",
        "id": "/id",
        "label": [
          "/login",
          "/name"
        ]
      },
      "revoke": {
        "url": "https://api.box.com/oauth2/revoke",
        "style": "rfc7009"
      },
      "scopes": {
        "base": [],
        "docs": "https://developer.box.com/guides/api-calls/permissions-and-errors/scopes/"
      },
      "injection": {
        "BOX_ACCESS_TOKEN": "/access_token",
        "BOX_TOKEN_EXPIRES_AT": "/expires_at"
      }
    }
  }
}
