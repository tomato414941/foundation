{
  "id": "zoom",
  "name": "Zoom",
  "api": "https://api.zoom.us/v2",
  "docs": "https://developers.zoom.us/docs/api/",
  "console": "https://marketplace.zoom.us/",
  "auth_schemes": {
    "oauth": {
      "authorize": "https://zoom.us/oauth/authorize",
      "token": "https://zoom.us/oauth/token",
      "identity": {
        "url": "https://api.zoom.us/v2/users/me",
        "id": "/id",
        "label": "/email",
        "optional": true
      },
      "revoke": {
        "url": "https://zoom.us/oauth/revoke",
        "style": "rfc7009"
      },
      "scopes": {
        "base": [],
        "docs": "https://developers.zoom.us/docs/integrations/oauth-scopes-overview/"
      },
      "injection": {
        "ZOOM_ACCESS_TOKEN": "/access_token",
        "ZOOM_TOKEN_EXPIRES_AT": "/expires_at"
      }
    }
  }
}
