{
  "version": 1,
  "id": "airtable",
  "name": "Airtable",
  "api": "https://api.airtable.com/v0",
  "docs": "https://airtable.com/developers/web/api/introduction",
  "console": "https://airtable.com/create/oauth",
  "auth_schemes": {
    "oauth": {
      "authorize": "https://airtable.com/oauth2/v1/authorize",
      "token": "https://airtable.com/oauth2/v1/token",
      "identity": {
        "url": "https://api.airtable.com/v0/meta/whoami",
        "id": "id",
        "label": "email"
      },
      "scopes": {
        "base": [
          "user.email:read"
        ],
        "docs": "https://airtable.com/developers/web/api/scopes"
      },
      "injection": {
        "AIRTABLE_ACCESS_TOKEN": "{access_token}",
        "AIRTABLE_TOKEN_EXPIRES_AT": "{expires_at}"
      }
    },
    "token": {
      "fields": [
        {
          "name": "token",
          "label": "Personal access token",
          "secret": true
        }
      ],
      "identity": {
        "url": "https://api.airtable.com/v0/meta/whoami",
        "headers": {
          "authorization": "Bearer {token}"
        },
        "id": "id",
        "label": "email"
      },
      "injection": {
        "AIRTABLE_TOKEN": "{token}"
      }
    }
  }
}
