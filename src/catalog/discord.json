{
  "version": 1,
  "id": "discord",
  "name": "Discord",
  "api": "https://discord.com/api/v10",
  "docs": "https://discord.com/developers/docs/reference",
  "console": "https://discord.com/developers/applications",
  "auth_schemes": {
    "oauth": {
      "authorize": "https://discord.com/oauth2/authorize",
      "token": "https://discord.com/api/oauth2/token",
      "identity": {
        "url": "https://discord.com/api/users/@me",
        "id": "id",
        "label": [
          "username",
          "global_name"
        ]
      },
      "revoke": {
        "url": "https://discord.com/api/oauth2/token/revoke",
        "style": "rfc7009"
      },
      "scopes": {
        "base": [
          "identify"
        ],
        "docs": "https://discord.com/developers/docs/topics/oauth2#shared-resources-oauth2-scopes"
      },
      "injection": {
        "DISCORD_ACCESS_TOKEN": "{access_token}",
        "DISCORD_TOKEN_EXPIRES_AT": "{expires_at}"
      }
    },
    "token": {
      "fields": [
        {
          "name": "token",
          "label": "Bot token",
          "secret": true
        }
      ],
      "identity": {
        "url": "https://discord.com/api/v10/users/@me",
        "headers": {
          "authorization": "Bot {token}"
        },
        "id": "id",
        "label": "username"
      },
      "injection": {
        "DISCORD_BOT_TOKEN": "{token}"
      },
      "hint": "Send it as \"Authorization: Bot <DISCORD_BOT_TOKEN>\"."
    }
  }
}
