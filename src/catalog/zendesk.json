{
  "id": "zendesk",
  "name": "Zendesk",
  "docs": "https://developer.zendesk.com/api-reference/",
  "auth_schemes": {
    "oauth": {
      "authorize": "https://{subdomain}.zendesk.com/oauth/authorizations/new",
      "token": "https://{subdomain}.zendesk.com/oauth/tokens",
      "client_auth": "body",
      "identity": {
        "url": "https://{subdomain}.zendesk.com/api/v2/users/me.json",
        "id": "/user/id",
        "label": [
          "/user/email",
          "/user/name"
        ]
      },
      "scopes": {
        "base": [
          "read"
        ],
        "docs": "https://developer.zendesk.com/api-reference/ticketing/oauth/oauth_tokens/"
      },
      "app_fields": [
        {
          "name": "subdomain",
          "label": "サブドメイン",
          "required": true,
          "leading": true,
          "placeholder": "example（example.zendesk.com の場合）",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        }
      ],
      "injection": {
        "ZENDESK_ACCESS_TOKEN": "/access_token",
        "ZENDESK_SUBDOMAIN": "/subdomain",
        "ZENDESK_TOKEN_EXPIRES_AT": "/expires_at"
      },
      "hint": "ZENDESK_SUBDOMAIN is the Zendesk subdomain (https://<ZENDESK_SUBDOMAIN>.zendesk.com/api/v2/...)."
    },
    "token": {
      "fields": [
        {
          "name": "subdomain",
          "label": "サブドメイン",
          "placeholder": "example（example.zendesk.com の場合）",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        {
          "name": "email",
          "label": "Zendeskのメールアドレス"
        },
        {
          "name": "token",
          "label": "APIトークン",
          "secret": true
        }
      ],
      "injection": {
        "ZENDESK_SUBDOMAIN": "/subdomain",
        "ZENDESK_EMAIL": "/email",
        "ZENDESK_API_TOKEN": "/token"
      },
      "hint": "Use HTTP Basic auth with \"<ZENDESK_EMAIL>/token\" as the user and ZENDESK_API_TOKEN as the password against https://<ZENDESK_SUBDOMAIN>.zendesk.com/api/v2/... The token is made in Admin Center under Apps and integrations > APIs."
    }
  }
}
