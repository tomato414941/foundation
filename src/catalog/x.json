{
  "version": 1,
  "id": "x",
  "name": "X",
  "api": "https://api.x.com/2",
  "docs": "https://docs.x.com/x-api/introduction",
  "console": "https://developer.x.com/en/portal/dashboard",
  "auth_schemes": {
    "oauth": {
      "authorize": "https://x.com/i/oauth2/authorize",
      "token": "https://api.x.com/2/oauth2/token",
      "identity": {
        "url": "https://api.x.com/2/users/me",
        "id": "data.id",
        "label": "data.username"
      },
      "revoke": {
        "url": "https://api.x.com/2/oauth2/revoke",
        "style": "rfc7009"
      },
      "scopes": {
        "base": [
          "tweet.read",
          "users.read",
          "offline.access"
        ],
        "docs": "https://docs.x.com/fundamentals/authentication/oauth-2-0/authorization-code"
      },
      "injection": {
        "X_ACCESS_TOKEN": "{access_token}",
        "X_TOKEN_EXPIRES_AT": "{expires_at}"
      }
    }
  }
}
