[Unit]
Description=Foundation execution environment
After=network-online.target docker.service
Wants=network-online.target
ConditionPathExists=/etc/foundation/environment.env

[Service]
Type=simple
EnvironmentFile=/etc/foundation/environment.env
ExecStart=/usr/local/bin/foundation-executor managed
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
UMask=0077
WorkingDirectory=/root

[Install]
WantedBy=multi-user.target
